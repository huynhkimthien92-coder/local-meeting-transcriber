{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeetingTranscriber",
  "version": "0.1.0",
  "identifier": "vn.thien.local-meeting-transcriber",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Biên Bản Họp — Chạy Local",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/meeting-backend", "binaries/ollama"],
    "resources": []
  }
}
